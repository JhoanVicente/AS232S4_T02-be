<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="product_detail_report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <property name="ireport.scriptlethandling" value="0"/>
    <property name="ireport.encoding" value="UTF-8"/>
    <import value="net.sf.jasperreports.engine.*"/>
    <import value="java.util.*"/>
    <import value="net.sf.jasperreports.engine.data.*"/>
    
    <parameter name="TICKET_ID" class="java.lang.Integer" isForPrompting="true">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    
    <queryString>
        <![CDATA[SELECT pd.id_detail_product, pd.amount, pd.ticket_id, 
       p.name as product_name, p.price, 
       (pd.amount * p.price) as subtotal,
       st.ticket_date
FROM product_detail pd
JOIN product p ON pd.product_id = p.product_id
JOIN sales_ticket st ON pd.ticket_id = st.ticket_id
WHERE ($P{TICKET_ID} IS NULL OR pd.ticket_id = $P{TICKET_ID})
ORDER BY pd.ticket_id, pd.id_detail_product]]>
    </queryString>
    
    <field name="ID_DETAIL_PRODUCT" class="java.math.BigDecimal"/>
    <field name="AMOUNT" class="java.math.BigDecimal"/>
    <field name="TICKET_ID" class="java.math.BigDecimal"/>
    <field name="PRODUCT_NAME" class="java.lang.String"/>
    <field name="PRICE" class="java.math.BigDecimal"/>
    <field name="SUBTOTAL" class="java.math.BigDecimal"/>
    <field name="TICKET_DATE" class="java.sql.Timestamp"/>
    
    <variable name="TOTAL_TICKET" class="java.math.BigDecimal" resetType="Group" resetGroup="TicketGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{SUBTOTAL}]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
    </variable>
    
    <group name="TicketGroup">
        <groupExpression><![CDATA[$F{TICKET_ID}]]></groupExpression>
        <groupHeader>
            <band height="40">
                <textField>
                    <reportElement x="0" y="10" width="802" height="20"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA["Ticket #" + $F{TICKET_ID} + " - Fecha: " + new SimpleDateFormat("dd/MM/yyyy HH:mm").format($F{TICKET_DATE})]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="30">
                <staticText>
                    <reportElement x="600" y="5" width="100" height="20"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Total del Ticket:]]></text>
                </staticText>
                <textField pattern="#,##0.00">
                    <reportElement x="700" y="5" width="100" height="20"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font isBold="true"/>
                    </textElement>
                    <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{TOTAL_TICKET}]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="0" y="0" width="802" height="1"/>
                </line>
                <line>
                    <reportElement x="0" y="29" width="802" height="1"/>
                </line>
            </band>
        </groupFooter>
    </group>
    
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Detalle de Productos]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="30" width="802" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{TICKET_ID} != null ? "Ticket #" + $P{TICKET_ID} : "Todos los Tickets"]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[ID Detalle]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[ID Ticket]]></text>
            </staticText>
            <staticText>
                <reportElement x="160" y="0" width="300" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[Producto]]></text>
            </staticText>
            <staticText>
                <reportElement x="460" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[Cantidad]]></text>
            </staticText>
            <staticText>
                <reportElement x="560" y="0" width="120" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[Precio Unitario]]></text>
            </staticText>
            <staticText>
                <reportElement x="680" y="0" width="122" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[Subtotal]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="25" width="802" height="1"/>
            </line>
        </band>
    </columnHeader>
    
    <detail>
        <band height="25">
            <textField>
                <reportElement x="0" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{ID_DETAIL_PRODUCT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{TICKET_ID}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="160" y="0" width="300" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{PRODUCT_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="460" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{AMOUNT}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="560" y="0" width="120" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{PRICE}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="680" y="0" width="122" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{SUBTOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="350" y="10" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression class="java.lang.String"><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="450" y="10" width="100" height="20"/>
                <textElement/>
                <textFieldExpression class="java.lang.String"><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>