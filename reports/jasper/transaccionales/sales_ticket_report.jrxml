<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="sales_ticket_report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <property name="ireport.scriptlethandling" value="0"/>
    <property name="ireport.encoding" value="UTF-8"/>
    <import value="net.sf.jasperreports.engine.*"/>
    <import value="java.util.*"/>
    <import value="net.sf.jasperreports.engine.data.*"/>
    
    <parameter name="FECHA" class="java.util.Date" isForPrompting="true">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    
    <queryString>
        <![CDATA[SELECT st.ticket_id, st.ticket_date, st.total_payment,
       st.delivery, st.delivery_address, st.note,
       ru.names || ' ' || ru.surnames AS user_full_name,
       ost.name AS status, pt.name AS payment_method
FROM sales_ticket st
JOIN restaurant_user ru ON st.user_id = ru.user_id
JOIN order_status_type ost ON st.id_type_state = ost.id_type_state
JOIN payment_type pt ON st.id_payment_type = pt.id_payment_type
WHERE ($P{FECHA} IS NULL OR TRUNC(st.ticket_date) = TRUNC($P{FECHA}))
ORDER BY st.ticket_date DESC]]>
    </queryString>
    
    <field name="TICKET_ID" class="java.math.BigDecimal"/>
    <field name="TICKET_DATE" class="java.sql.Timestamp"/>
    <field name="TOTAL_PAYMENT" class="java.math.BigDecimal"/>
    <field name="DELIVERY" class="java.lang.String"/>
    <field name="DELIVERY_ADDRESS" class="java.lang.String"/>
    <field name="NOTE" class="java.lang.String"/>
    <field name="USER_FULL_NAME" class="java.lang.String"/>
    <field name="STATUS" class="java.lang.String"/>
    <field name="PAYMENT_METHOD" class="java.lang.String"/>
    
    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Ventas]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="0" y="30" width="802" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression class="java.util.Date"><![CDATA[$P{FECHA}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="150" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
            <staticText>
                <reportElement x="230" y="0" width="60" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Delivery]]></text>
            </staticText>
            <staticText>
                <reportElement x="290" y="0" width="120" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Dirección de Entrega]]></text>
            </staticText>
            <staticText>
                <reportElement x="410" y="0" width="120" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Nota]]></text>
            </staticText>
            <staticText>
                <reportElement x="530" y="0" width="120" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Usuario]]></text>
            </staticText>
            <staticText>
                <reportElement x="650" y="0" width="70" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
            <staticText>
                <reportElement x="720" y="0" width="82" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Método de Pago]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="25" width="802" height="1"/>
            </line>
        </band>
    </columnHeader>
    
    <detail>
        <band height="25">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{TICKET_ID}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="50" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.sql.Timestamp"><![CDATA[$F{TICKET_DATE}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="150" y="0" width="80" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{TOTAL_PAYMENT}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="230" y="0" width="60" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{DELIVERY}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="290" y="0" width="120" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{DELIVERY_ADDRESS}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="410" y="0" width="120" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{NOTE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="530" y="0" width="120" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{USER_FULL_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="650" y="0" width="70" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{STATUS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="720" y="0" width="82" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{PAYMENT_METHOD}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="350" y="10" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression class="java.lang.String"><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="450" y="10" width="100" height="20"/>
                <textElement/>
                <textFieldExpression class="java.lang.String"><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>