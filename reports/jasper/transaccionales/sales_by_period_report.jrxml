<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="sales_by_period_report" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
    <property name="ireport.scriptlethandling" value="0"/>
    <property name="ireport.encoding" value="UTF-8"/>
    <import value="net.sf.jasperreports.engine.*"/>
    <import value="java.util.*"/>
    <import value="net.sf.jasperreports.engine.data.*"/>
    
    <parameter name="FECHA_INICIO" class="java.util.Date" isForPrompting="true">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    
    <parameter name="FECHA_FIN" class="java.util.Date" isForPrompting="true">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    
    <queryString>
        <![CDATA[SELECT TRUNC(ticket_date) as fecha,
       COUNT(ticket_id) as cantidad_ventas,
       SUM(total_payment) as total_ventas,
       AVG(total_payment) as promedio_venta
FROM sales_ticket
WHERE (($P{FECHA_INICIO} IS NULL AND $P{FECHA_FIN} IS NULL) OR 
      (ticket_date BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN}))
GROUP BY TRUNC(ticket_date)
ORDER BY fecha DESC]]>
    </queryString>
    
    <field name="FECHA" class="java.sql.Timestamp"/>
    <field name="CANTIDAD_VENTAS" class="java.math.BigDecimal"/>
    <field name="TOTAL_VENTAS" class="java.math.BigDecimal"/>
    <field name="PROMEDIO_VENTA" class="java.math.BigDecimal"/>
    
    <variable name="TOTAL_CANTIDAD" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{CANTIDAD_VENTAS}]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
    </variable>
    
    <variable name="TOTAL_VENTAS" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TOTAL_VENTAS}]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
    </variable>
    
    <variable name="PROMEDIO_GENERAL" class="java.math.BigDecimal">
        <variableExpression><![CDATA[$V{TOTAL_VENTAS}.divide($V{TOTAL_CANTIDAD}, 2, java.math.RoundingMode.HALF_UP)]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
    </variable>
    
    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Ventas por Período]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="0" y="30" width="535" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[($P{FECHA_INICIO} != null && $P{FECHA_FIN} != null) ? 
                "Desde: " + new SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " Hasta: " + new SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN}) : 
                "Todas las fechas"]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="135" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="135" y="0" width="135" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Cantidad de Ventas]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="0" width="135" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Total Ventas]]></text>
            </staticText>
            <staticText>
                <reportElement x="405" y="0" width="130" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Promedio por Venta]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="25" width="535" height="1"/>
            </line>
        </band>
    </columnHeader>
    
    <detail>
        <band height="25">
            <textField pattern="dd/MM/yyyy">
                <reportElement x="0" y="0" width="135" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression class="java.sql.Timestamp"><![CDATA[$F{FECHA}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="135" y="0" width="135" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{CANTIDAD_VENTAS}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="270" y="0" width="135" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{TOTAL_VENTAS}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="405" y="0" width="130" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{PROMEDIO_VENTA}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <summary>
        <band height="30">
            <staticText>
                <reportElement x="0" y="5" width="135" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[TOTALES:]]></text>
            </staticText>
            <textField>
                <reportElement x="135" y="5" width="135" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{TOTAL_CANTIDAD}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="270" y="5" width="135" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{TOTAL_VENTAS}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="405" y="5" width="130" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{PROMEDIO_GENERAL}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="0" width="535" height="1"/>
            </line>
        </band>
    </summary>
    
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="200" y="10" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression class="java.lang.String"><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="300" y="10" width="100" height="20"/>
                <textElement/>
                <textFieldExpression class="java.lang.String"><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>