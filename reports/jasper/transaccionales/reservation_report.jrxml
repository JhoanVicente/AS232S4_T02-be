<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="reservation_report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <property name="ireport.scriptlethandling" value="0"/>
    <property name="ireport.encoding" value="UTF-8"/>
    <import value="net.sf.jasperreports.engine.*"/>
    <import value="java.util.*"/>
    <import value="net.sf.jasperreports.engine.data.*"/>
    
    <parameter name="FECHA" class="java.util.Date" isForPrompting="true">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    
    <queryString>
        <![CDATA[SELECT r.reservation_id, r.reservation_name, r.reservation_date,
       ru.names || ' ' || ru.surnames AS user_full_name,
       ost.name AS status,
       rd.number_people, rd.reservation_method, rd.request,
       t.table_number
FROM reservation r
JOIN restaurant_user ru ON r.user_id = ru.user_id
JOIN order_status_type ost ON r.id_type_state = ost.id_type_state
JOIN reservation_detail rd ON r.reservation_id = rd.reservation_id
JOIN "TABLE" t ON rd.table_id = t.table_id
WHERE ($P{FECHA} IS NULL OR TRUNC(r.reservation_date) = TRUNC($P{FECHA}))
ORDER BY r.reservation_date DESC]]>
    </queryString>
    
    <field name="RESERVATION_ID" class="java.math.BigDecimal"/>
    <field name="RESERVATION_NAME" class="java.lang.String"/>
    <field name="RESERVATION_DATE" class="java.sql.Timestamp"/>
    <field name="USER_FULL_NAME" class="java.lang.String"/>
    <field name="STATUS" class="java.lang.String"/>
    <field name="NUMBER_PEOPLE" class="java.math.BigDecimal"/>
    <field name="RESERVATION_METHOD" class="java.lang.String"/>
    <field name="REQUEST" class="java.lang.String"/>
    <field name="TABLE_NUMBER" class="java.math.BigDecimal"/>
    
    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Reservaciones]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="0" y="30" width="802" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression class="java.util.Date"><![CDATA[$P{FECHA}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="150" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Nombre de Reserva]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="0" width="150" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Usuario]]></text>
            </staticText>
            <staticText>
                <reportElement x="450" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
            <staticText>
                <reportElement x="530" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Personas]]></text>
            </staticText>
            <staticText>
                <reportElement x="580" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Método]]></text>
            </staticText>
            <staticText>
                <reportElement x="660" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Solicitud]]></text>
            </staticText>
            <staticText>
                <reportElement x="760" y="0" width="42" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="8"/>
                </textElement>
                <text><![CDATA[Mesa]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="25" width="802" height="1"/>
            </line>
        </band>
    </columnHeader>
    
    <detail>
        <band height="25">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{RESERVATION_ID}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="150" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{RESERVATION_NAME}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="200" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.sql.Timestamp"><![CDATA[$F{RESERVATION_DATE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="0" width="150" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{USER_FULL_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="450" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{STATUS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="530" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{NUMBER_PEOPLE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="580" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{RESERVATION_METHOD}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="660" y="0" width="100" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{REQUEST}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="760" y="0" width="42" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{TABLE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="350" y="10" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression class="java.lang.String"><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="450" y="10" width="100" height="20"/>
                <textElement/>
                <textFieldExpression class="java.lang.String"><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>