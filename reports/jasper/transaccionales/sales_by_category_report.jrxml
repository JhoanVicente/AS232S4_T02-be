<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="sales_by_category_report" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
    <property name="ireport.scriptlethandling" value="0"/>
    <property name="ireport.encoding" value="UTF-8"/>
    <import value="net.sf.jasperreports.engine.*"/>
    <import value="java.util.*"/>
    <import value="net.sf.jasperreports.engine.data.*"/>
    
    <parameter name="FECHA_INICIO" class="java.util.Date" isForPrompting="true">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    
    <parameter name="FECHA_FIN" class="java.util.Date" isForPrompting="true">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    
    <queryString>
        <![CDATA[SELECT c.category_id, c.name as category_name, 
       COUNT(pd.id_detail_product) as total_items,
       SUM(pd.amount) as total_quantity,
       SUM(pd.amount * p.price) as total_sales
FROM category c
JOIN product p ON c.category_id = p.category_id
JOIN product_detail pd ON p.product_id = pd.product_id
JOIN sales_ticket st ON pd.ticket_id = st.ticket_id
WHERE (($P{FECHA_INICIO} IS NULL AND $P{FECHA_FIN} IS NULL) OR 
      (st.ticket_date BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN}))
GROUP BY c.category_id, c.name
ORDER BY total_sales DESC]]>
    </queryString>
    
    <field name="CATEGORY_ID" class="java.math.BigDecimal"/>
    <field name="CATEGORY_NAME" class="java.lang.String"/>
    <field name="TOTAL_ITEMS" class="java.math.BigDecimal"/>
    <field name="TOTAL_QUANTITY" class="java.math.BigDecimal"/>
    <field name="TOTAL_SALES" class="java.math.BigDecimal"/>
    
    <variable name="GRAND_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TOTAL_SALES}]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
    </variable>
    
    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Ventas por Categoría]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="0" y="30" width="535" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[($P{FECHA_INICIO} != null && $P{FECHA_FIN} != null) ? 
                "Desde: " + new SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " Hasta: " + new SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN}) : 
                "Todas las fechas"]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="200" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[Categoría]]></text>
            </staticText>
            <staticText>
                <reportElement x="250" y="0" width="85" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[Productos Vendidos]]></text>
            </staticText>
            <staticText>
                <reportElement x="335" y="0" width="85" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[Cantidad Total]]></text>
            </staticText>
            <staticText>
                <reportElement x="420" y="0" width="115" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[Total Ventas]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="25" width="535" height="1"/>
            </line>
        </band>
    </columnHeader>
    
    <detail>
        <band height="25">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{CATEGORY_ID}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="200" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{CATEGORY_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="0" width="85" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{TOTAL_ITEMS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="335" y="0" width="85" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{TOTAL_QUANTITY}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="420" y="0" width="115" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{TOTAL_SALES}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <summary>
        <band height="40">
            <line>
                <reportElement x="0" y="0" width="535" height="1"/>
            </line>
            <staticText>
                <reportElement x="320" y="10" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[Total General:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="420" y="10" width="115" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{GRAND_TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
    
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="200" y="10" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression class="java.lang.String"><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="300" y="10" width="100" height="20"/>
                <textElement/>
                <textFieldExpression class="java.lang.String"><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>