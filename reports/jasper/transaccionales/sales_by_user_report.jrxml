<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="sales_by_user_report" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
    <property name="ireport.scriptlethandling" value="0"/>
    <property name="ireport.encoding" value="UTF-8"/>
    <import value="net.sf.jasperreports.engine.*"/>
    <import value="java.util.*"/>
    <import value="net.sf.jasperreports.engine.data.*"/>
    
    <parameter name="FECHA_INICIO" class="java.util.Date" isForPrompting="true">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    
    <parameter name="FECHA_FIN" class="java.util.Date" isForPrompting="true">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    
    <queryString>
        <![CDATA[SELECT ru.user_id, ru.user_name, 
       ru.names || ' ' || ru.surnames AS user_full_name,
       ut.name as user_type,
       COUNT(st.ticket_id) as total_tickets,
       SUM(st.total_payment) as total_sales
FROM restaurant_user ru
JOIN user_type ut ON ru.user_type_id = ut.user_type_id
LEFT JOIN sales_ticket st ON ru.user_id = st.user_id
WHERE (($P{FECHA_INICIO} IS NULL AND $P{FECHA_FIN} IS NULL) OR 
      (st.ticket_date BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN}))
GROUP BY ru.user_id, ru.user_name, ru.names, ru.surnames, ut.name
ORDER BY total_sales DESC NULLS LAST]]>
    </queryString>
    
    <field name="USER_ID" class="java.math.BigDecimal"/>
    <field name="USER_NAME" class="java.lang.String"/>
    <field name="USER_FULL_NAME" class="java.lang.String"/>
    <field name="USER_TYPE" class="java.lang.String"/>
    <field name="TOTAL_TICKETS" class="java.math.BigDecimal"/>
    <field name="TOTAL_SALES" class="java.math.BigDecimal"/>
    
    <variable name="GRAND_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TOTAL_SALES}]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
    </variable>
    
    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Ventas por Usuario]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="0" y="30" width="535" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[($P{FECHA_INICIO} != null && $P{FECHA_FIN} != null) ? 
                "Desde: " + new SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO}) + " Hasta: " + new SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_FIN}) : 
                "Todas las fechas"]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="40" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="9"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="40" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="9"/>
                </textElement>
                <text><![CDATA[Usuario]]></text>
            </staticText>
            <staticText>
                <reportElement x="120" y="0" width="150" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="9"/>
                </textElement>
                <text><![CDATA[Nombre Completo]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="9"/>
                </textElement>
                <text><![CDATA[Tipo de Usuario]]></text>
            </staticText>
            <staticText>
                <reportElement x="370" y="0" width="65" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="9"/>
                </textElement>
                <text><![CDATA[# Tickets]]></text>
            </staticText>
            <staticText>
                <reportElement x="435" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="9"/>
                </textElement>
                <text><![CDATA[Total Ventas]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="25" width="535" height="1"/>
            </line>
        </band>
    </columnHeader>
    
    <detail>
        <band height="25">
            <textField>
                <reportElement x="0" y="0" width="40" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{USER_ID}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="40" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{USER_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="120" y="0" width="150" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{USER_FULL_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{USER_TYPE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="370" y="0" width="65" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{TOTAL_TICKETS}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="435" y="0" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{TOTAL_SALES}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <summary>
        <band height="30">
            <staticText>
                <reportElement x="335" y="5" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Total General:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="435" y="5" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{GRAND_TOTAL}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="0" width="535" height="1"/>
            </line>
        </band>
    </summary>
    
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="200" y="10" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression class="java.lang.String"><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="300" y="10" width="100" height="20"/>
                <textElement/>
                <textFieldExpression class="java.lang.String"><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>