<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:x="http://www.w3.org/2001/XMLSchema-instance"
              x:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                               http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="reservas_report" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Parameters -->
    <parameter name="reservas" class="java.util.List"/>

    <!-- Fields -->
    <field name="name" class="java.lang.String"/>
    <field name="fechaRegistro" class="java.time.LocalDate"/>
    <field name="numeroCelular" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="detalleReservas.descripcion" class="java.lang.String"/>
    <field name="detalleReservas.fechaReserva" class="java.time.LocalDate"/>
    <field name="detalleReservas.horaReserva" class="java.time.LocalTime"/>
    <field name="detalleReservas.numeroPersonas" class="java.lang.Integer"/>
    <field name="detalleReservas.status" class="java.lang.String"/>

    <!-- Title -->
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Reporte de Reservas]]></text>
            </staticText>
        </band>
    </title>

    <!-- Table Header -->
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Nombre]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="0" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Fecha de Registro]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Número Celular]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="0" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Estado]]></text>
            </staticText>
            <staticText>
                <reportElement x="400" y="0" width="155" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Descripción]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Section for Reservas -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="100" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{fechaRegistro}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{numeroCelular}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="0" width="155" height="20"/>
                <textFieldExpression><![CDATA[$F{detalleReservas.descripcion}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Reporte generado con JasperReports]]></text>
            </staticText>
        </band>
    </pageFooter>
</jasperReport>
